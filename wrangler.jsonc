{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-terminology",
  "account_id": "413cb81347f3e89932f12e3ed9a6d062", // Nicole's Cloudflare account
  "compatibility_date": "2026-05-03",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Per-IP cap on the public /api/ask-lexi endpoint (free, built into Workers).
  // period must be 10 or 60 seconds. namespace_id is any account-unique number.
  "ratelimits": [
    { "name": "LEXI_LIMITER", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } }
  ]
}
